# =============================================================================
# RESEARCHX BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Security & JWT Token Signing (Generate a strong random 32+ character key for production)
SECRET_KEY=your_super_secret_jwt_key_here_generate_a_random_32_byte_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Database Configuration (Multi-Dialect Support: SQLite & PostgreSQL)
# -----------------------------------------------------------------------------
# Option A: Local Development (Default if DATABASE_URL is left empty or set to sqlite)
DATABASE_URL=sqlite:///researchx.db

# Option B: Render Internal PostgreSQL (e.g. on Render web service deployment)
# DATABASE_URL=postgres://researchx_user:your_password@dpg-sample.render.com/researchx_db

# Option C: Production PostgreSQL / Supabase / Neon / AWS RDS
# DATABASE_URL=postgresql://postgres:your_password@ep-sample-123456.us-east-2.aws.neon.tech/researchx?sslmode=require

# -----------------------------------------------------------------------------
# Frontend Production URL & CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Initial Administrator Account Credentials (Idempotent seed on first startup)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@researchx.com
ADMIN_PASSWORD=Admin@2026

# -----------------------------------------------------------------------------
# Optional: External AI / LLM APIs (Leave empty to use built-in semantic NLP reasoning engine)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Gmail SMTP Notification Settings (Leave empty to skip SMTP emails)
# -----------------------------------------------------------------------------
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=ResearchX Team
