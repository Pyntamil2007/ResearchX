# =============================================================================
# RESEARCHX BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Security & JWT Token Generation (Replace with a strong random secret in production)
SECRET_KEY=your_super_secret_jwt_key_here_generate_a_random_32_byte_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Database Connection String
DATABASE_URL=sqlite:///researchx.db

# Frontend Production URL (e.g., https://your-app.vercel.app)
FRONTEND_URL=https://your-app.vercel.app

# Additional CORS Allowed Origins (Comma-separated if multiple domains)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Initial Administrator Account Credentials
ADMIN_EMAIL=admin@researchx.com
ADMIN_PASSWORD=Admin@2026

# Optional: External AI / LLM APIs (Leave empty to use built-in semantic NLP reasoning engine)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Gmail SMTP Notification Settings (Leave empty to skip SMTP emails)
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=ResearchX Team
