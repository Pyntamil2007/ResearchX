# =============================================================================
# RESEARCHX FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Render Backend URL (Example: https://researchx-backend.onrender.com)
# In local development, you can leave this empty (Vite will proxy /api to http://127.0.0.1:8000)
# In production on Vercel, set this to your deployed Render service URL:
VITE_API_URL=https://your-render-backend.onrender.com
